// Test FlexBoxLayout with column direction and basic wrapping

export component TestCase inherits Window {
    width: 200px;
    height: 200px;

    // Test basic column wrapping: items stack vertically
    FlexBoxLayout {
        flex-direction: column;
        spacing: 5px;
        padding: 0px;

        r1 := Rectangle {
            width: 30px;
            height: 50px;
            background: red;
        }

        r2 := Rectangle {
            width: 30px;
            height: 50px;
            background: green;
        }

        r3 := Rectangle {
            width: 30px;
            height: 60px;
            background: blue;
        }
    }

    // r1 and r2 fit vertically (50+5+50=105 < 200), r3 does NOT wrap because 105+5+60=170 < 200
    // All items stay in first column
    out property <bool> test: r1.x == 0px && r1.y == 0px && r2.x == 0px && r2.y == 55px && r3.x == 0px && r3.y == 110px;
}

/*
```cpp
auto handle = TestCase::create();
assert(handle->get_test());
```

```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```
*/
